{
  "Serilog": {
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/dev-log.txt",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "Console",
        "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss}{Level:u3}] {Message:lj}{NewLine}{Exception}" }
      }
    ]
  }
}